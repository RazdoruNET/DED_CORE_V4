# Configuration files that might contain sensitive data
config/secrets.h
config/local.h

# Ключи и сертификаты в любом месте дерева: случайно добавленный файл не должен
# уехать в публичный репозиторий. Материал TLS блока тоже под это правило попадает.
*.pem
*.key
*.crt
*.pfx
*.p12
*.der
*.token

# Data directory (web files).
# Правила игнорирования здесь нет намеренно: data/ — это собранный вшитый фронт,
# он лежит в репозитории, и из него PlatformIO собирает образ файловой системы.
# С прежним правилом `data/` новая сборка молча не попадала в коммит, а старая
# из него удалялась — в опубликованном образе оставался битый bundle.
# Артефакты сборки фронта (web/node_modules, web/dist) игнорируются отдельно.

# Documentation build
docs/_build/
docs/.doctrees/

# Test results
test_results/
coverage/
# PIO генерирует этот файл при сборке .ino — в репозиторий он не нужен
src/DED_CORE_V4.ino.cpp
